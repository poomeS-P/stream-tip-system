# ============================================================
# stream-tip-system — ตัวอย่าง environment variables
#
# ⚠️ ไฟล์นี้มีแต่ "ค่า placeholder" — ห้ามใส่ค่าจริง/secret ลงในไฟล์นี้
# ⚠️ ห้าม commit ไฟล์ .env จริง (.gitignore กันไว้ด้วย `.env*`)
# วิธีใช้:
#   - ในเครื่อง : copy ไฟล์นี้เป็น .env แล้วแก้ค่า
#   - production: ตั้งค่าที่ Railway → Service → Variables (ดู docs/RAILWAY_DEPLOY.md)
# ============================================================

# --- Runtime ---
# PORT: Railway ฉีดค่าให้เองอัตโนมัติ → "ห้ามตั้ง PORT ใน Railway"
#       ค่า 3300 ด้านล่างมีไว้สำหรับรันในเครื่องเท่านั้น
NODE_ENV=development
PORT=3300

# NEXT_PUBLIC_APP_URL: URL สาธารณะของแอป (ใช้สร้าง success/cancel URL ให้ Stripe)
#   ในเครื่อง : http://localhost:3300
#   production: https://<your-service>.up.railway.app  ← ต้องตรงกับ domain จริง
NEXT_PUBLIC_APP_URL=http://localhost:3300

# --- Database (PostgreSQL) ---
# ในเครื่อง: docker compose up -d db
# Railway   : เพิ่ม Reference Variable → ${{Postgres.DATABASE_URL}} (ไม่ต้องพิมพ์ค่าเอง)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Local Docker DB (ใช้โดย docker-compose.yml เท่านั้น / dev) ---
# docker-compose.yml อ่านค่าจาก .env → ถ้าไม่ตั้ง POSTGRES_PASSWORD compose จะหยุดพร้อมข้อความอธิบาย
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_local_dev_db_password
POSTGRES_DB=stream_tip_db

# --- Security tokens (ยาว ≥ 16 ตัวอักษร และ "ห้ามใช้ค่าเดียวกัน") ---
ADMIN_TOKEN=replace_with_random_string_min_16_chars
OVERLAY_TOKEN=replace_with_another_random_string_min_16_chars

# --- Payment provider (ค่าเริ่มต้น stripe — ดู src/lib/payment/index.ts) ---
# PAYMENT_PROVIDER=stripe

# --- Stripe (รอบนี้ใช้ Test Mode เท่านั้น) ---
# STRIPE_SECRET_KEY / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#   → Stripe Dashboard → Developers → API keys (ต้องเป็นบัญชีเดียวกับที่ใช้จ่ายเงิน)
#
# STRIPE_WEBHOOK_SECRET เลือกได้ 2 ทาง (ต้องตรงกับบัญชีของ STRIPE_SECRET_KEY):
#   a) production: Stripe Dashboard → Developers → Webhooks → Add endpoint
#      URL: https://<your-service>.up.railway.app/api/webhooks/payment
#   b) ในเครื่อง: stripe listen --print-secret --api-key <STRIPE_SECRET_KEY>
#      (หรือใช้ scripts/start-stripe-listen.ps1 ซึ่งผูกบัญชีให้อัตโนมัติ)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Defaults ---
DEFAULT_CURRENCY=THB

# --- Alert: ระยะเวลาที่ค้างบนจอ (ไม่บังคับ — มีค่าเริ่มต้นในโค้ดแล้ว) ---
# ยิ่งข้อความยาว ยิ่งค้างนานขึ้น โดยไม่เกินเพดาน (ดู src/lib/alert-duration.ts)
# ค่าเริ่มต้น: 110 ms/ตัวอักษร · 2500 ms ตั้งต้น · เพดาน 20 วินาที
# ALERT_READ_MS_PER_CHAR=110
# ALERT_READ_BASE_MS=2500
# ALERT_MAX_DURATION_SEC=20

# --- หน้าเว็บรับโดเนท (Smoke theme) — ทั้งหมด "ไม่บังคับ" ---
# เป้าหมายการสนับสนุนต่อเดือน (บาท) — ไม่ใส่ = 5000, ใส่ 0 = ซ่อนส่วนเป้าหมาย
# SUPPORT_GOAL_THB=5000
#
# PromptPay QR (ช่องทางโอนตรง — ยังไม่เชื่อมระบบตรวจยอดอัตโนมัติ):
#   วางไฟล์รูป QR ที่ public/promptpay-qr.png แล้วตั้งค่าด้านล่างให้ตรงกับบัญชีจริง
# NEXT_PUBLIC_PROMPTPAY_NAME=ชื่อบัญชีที่แสดงบนสลิป
# NEXT_PUBLIC_PROMPTPAY_ID=0812345678
#
# ช่องทางติดต่อใน Footer (ใส่เฉพาะอันที่ใช้ — อันที่ไม่ใส่จะไม่แสดง)
# NEXT_PUBLIC_CONTACT_TWITCH=https://www.twitch.tv/your_channel
# NEXT_PUBLIC_CONTACT_DISCORD=https://discord.gg/your_invite
# NEXT_PUBLIC_CONTACT_X=https://x.com/your_account
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

